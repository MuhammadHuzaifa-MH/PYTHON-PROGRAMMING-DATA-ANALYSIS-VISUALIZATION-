import streamlit as st
import pandas as pd
import plotly.express as px

st.set_page_config(page_title="Employee Attrition Dashboard", layout="wide")
st.title("💼 Employee Attrition & Interactive Analytics Dashboard")
st.markdown("### Devixo Solutions AI/ML Internship - Task 01 Bonus Dashboard")

@st.cache_data
def load_data():
    df = pd.read_csv('Employee.csv')
    if df.duplicated().sum() > 0:
        df.drop_duplicates(inplace=True)
    return df

df = load_data()

# Sidebar
st.sidebar.header("🔍 Filters")
city = st.sidebar.multiselect("City:", options=df['City'].unique(), default=df['City'].unique())
edu = st.sidebar.multiselect("Education:", options=df['Education'].unique(), default=df['Education'].unique())
tier = st.sidebar.multiselect("Payment Tier:", options=sorted(df['PaymentTier'].unique()), default=sorted(df['PaymentTier'].unique()))

filtered_df = df[(df['City'].isin(city)) & (df['Education'].isin(edu)) & (df['PaymentTier'].isin(tier))]

# KPIs
col1, col2, col3, col4 = st.columns(4)
col1.metric("Total Employees", len(filtered_df))
col2.metric("Total Attrition", int(filtered_df['LeaveOrNot'].sum()))
col3.metric("Attrition Rate", f"{(filtered_df['LeaveOrNot'].mean()*100):.2f}%")
col4.metric("Average Age", f"{filtered_df['Age'].mean():.1f} Yrs")

st.divider()

# Tabs
tab1, tab2, tab3 = st.tabs(["📈 Visuals", "📋 Statistics", "💡 Insights"])

with tab1:
    fig = px.histogram(filtered_df, x="Age", color="LeaveOrNot", barmode="overlay", title="Age Distribution by Attrition")
    st.plotly_chart(fig, use_container_width=True)

with tab2:
    st.dataframe(filtered_df.describe())

with tab3:
    st.markdown("""
    * **Overall Attrition Rate:** ~39.36%
    * **Key Finding:** Younger employees (22-30 years) exhibit higher turnover.
    * **Payment Tiers:** Tier 1 & 2 show different attrition dynamics compared to Tier 3.
    """)

